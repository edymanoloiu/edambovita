{
  "name": "edambovita",
  "version": "1.1.0",
  "private": true,
  "packageManager": "npm@10",
  "scripts": {
    "generate:rss": "node scripts/generate-rss.js",
    "generate:posts": "node scripts/generate-posts-json.js",
    "prebuild": "npm run generate:posts && npm run generate:evergreen && npm run generate:search && npm run content:validate",
    "dev": "next dev --webpack",
    "build": "npm run generate:evergreen && NODE_ENV=production next build --webpack && node scripts/postbuild.cjs",
    "start": "next start",
    "export": "npm run build && next export",
    "lint": "next lint",
    "postbuild": "npm run generate:rss && node scripts/ensure-next-lock.cjs",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev",
    "deploy": "npm run pages:build && wrangler pages deploy",
    "open-next:build": "open-next build --webpack",
    "cf:build": "npm run generate:evergreen && opennextjs-cloudflare build",
    "cf:deploy": "npm run generate:evergreen && opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare upload",
    "generate:search": "node scripts/generate-search-index.js",
    "content:validate": "node scripts/content-validate.js",
    "content:report": "node scripts/content-report.js",
    "links:check": "node scripts/links-check.js",
    "seo:check": "node scripts/seo-check.js",
    "generate:local-evergreen": "node scripts/generate-local-evergreen.js",
    "test:local-evergreen": "node tests/generate-local-evergreen.test.js",
    "generate:evergreen": "node scripts/generate-evergreen-assets.js"
  },
  "dependencies": {
    "@emailjs/browser": "^3.7.0",
    "axios": "^1.7.2",
    "bootstrap": "^5.3.3",
    "gray-matter": "^4.0.3",
    "js-cookie": "^3.0.5",
    "luxon": "^3.0.3",
    "next": "^16.2.4",
    "next-sitemap": "^4.2.3",
    "react": "^19.2.0",
    "react-bootstrap": "^2.5.0",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "^19.2.0",
    "react-responsive-masonry": "^2.1.6",
    "react-slick": "^0.29.0",
    "remark": "^14.0.2",
    "remark-gfm": "^3.0.1",
    "remark-html": "^15.0.1",
    "rss": "^1.2.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.8",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.2.4",
    "open-next": "^3.1.3",
    "wrangler": "^4.86.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
