{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "cloudflare-worker.js",
	"name": "edambovita",
	"compatibility_date": "2025-12-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"cache": {
		"enabled": true
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 0.05,
			"invocation_logs": false,
			"persist": false
		},
		"enabled": false
	}
	// No services (removed WORKER_SELF_REFERENCE)
	// No images binding
	// No R2 buckets (cache disabled in open-next.config.ts)
}